{
  "version": 2,
  "ignoreCommand": "bash tools/vercel_ignore_build.sh",
  "builds": [
    {
      "src": "run.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "run.py"
    }
  ],
  "crons": [
    {
      "path": "/demo/reset",
      "schedule": "30 20 * * *"
    }
  ]
}
