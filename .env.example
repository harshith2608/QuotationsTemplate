# Copy to .env for local development. In production, set these in your host's
# dashboard (Render / Vercel / Heroku). Never commit a real .env file.

# ── Required in production ────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Each deployment gets its OWN Postgres database (Neon / Supabase / Render Postgres).
# Leave unset locally to use a SQLite file (app.db). The app refuses to start in
# production without it.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Encrypts customer details, amounts, rates and payment secrets in the database.
# One per deployment. LOSING IT MEANS LOSING THE DATA: keep a copy in a password manager.
# Leave unset locally to store data unencrypted (development only).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: NEW_KEY,OLD_KEY (encrypts with the first, reads with either; then run `flask encrypt-data`)
DATA_ENCRYPTION_KEY=

# "production" when deployed; "development" (default) locally
FLASK_ENV=development

# ── First admin user (used once by `flask bootstrap`) ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Branding defaults ─────────────────────────────────────────────────────────
# Starting values for a new deployment. The client's admin can change ALL of these
# later from Admin → Settings (Company / Appearance); a saved value there wins,
# and clearing it falls back to what's set here.
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_GSTIN=
COMPANY_TAGLINE=Interior Design & Furnishing Solutions
SIGNATORY_NAME=
SIGNATORY_TITLE=Proprietor

# Theme — colours as #rrggbb (invalid values fall back to the defaults shown)
BRAND_PRIMARY=#1a237e
BRAND_SECONDARY=#283593
BRAND_ACCENT=#f57f17
BRAND_BACKGROUND=#f5f6fa
BRAND_HEADER=gradient        # gradient | solid | light
BRAND_CORNERS=rounded        # sharp | rounded | soft
BRAND_BUTTONS=standard       # standard | pill
BRAND_FONT=system            # system | inter | poppins | montserrat | lato | nunito | dm-sans | lora

# Company name, GSTIN and logo lock once the client saves them (one subscription = one
# business). Unlock a field for one change with: flask company-unlock name|gstin|logo
LOCK_COMPANY_DETAILS=1
# Your support WhatsApp (digits with country code), linked from locked fields in Settings
SUPPORT_WHATSAPP=

# Optional logo baked into the deployment: a PNG/JPG under static/, e.g. brand/logo.png.
# A logo uploaded in Admin → Settings → Appearance takes precedence.
LOGO_FILE=

# ── Demo data (used by `flask seed-demo` and the demo reset) ──────────────────
# On a public demo set this to something long and random — visitors use /demo, not a password.
DEMO_PASSWORD=demo1234

# ── Public demo mode (ONLY on your own demo/marketing deployment) ────────────
# /demo signs visitors into DEMO_USER with one click; admin saves, deletes, payment
# links and access changes are blocked; PDFs get a "DEMO — NOT A VALID QUOTATION"
# watermark. With CRON_SECRET set, the Vercel cron in vercel.json resets the demo
# data nightly (02:00 IST) — this WIPES THE WHOLE DATABASE, so never enable it on a client.
DEMO_MODE=
DEMO_USER=demo-admin
CRON_SECRET=

# ── Payments & email ──────────────────────────────────────────────────────────
# Razorpay keys and UPI / bank details (Admin → Payment Settings) and SMTP
# (Admin → Settings → Email) are entered by an admin and stored in the database.

# ── Marketing page (ONLY on your own demo/marketing deployment) ──────────────
# Serves the product's public landing page at / (for signed-out visitors) and
# /landingpage, plus /privacy and /terms. Leave unset on client deployments.
MARKETING_SITE=
MARKETING_PRODUCT_NAME=QuoteRoom
MARKETING_WHATSAPP=919999999999          # country code + number, digits only
META_PIXEL_ID=                           # optional, Meta Pixel ID (digits)
GOOGLE_ADS_ID=                           # optional, e.g. AW-123456789
GOOGLE_ADS_CONVERSION=                   # optional, e.g. AW-123456789/AbCdEf (fired on trial requests and plan WhatsApp clicks)
# Ad tags load only after the visitor accepts the cookie notice (shown only when an ID above is set).
# ── Operator console (its own Vercel project only; see docs/OPERATIONS.md 3f) ──
# CONSOLE_MODE=1                          serve only the console; DATABASE_URL / DATA_ENCRYPTION_KEY = the trials DB's
# CONSOLE_PASSWORD_HASH= CONSOLE_TOTP_SECRET=   from `flask console-setup`
# LEADS_DATABASE_URL= LEADS_DATA_ENCRYPTION_KEY=  the marketing/demo DB, to show trial requests
LEADS_PASSWORD=                          # opens /leads (free-trial requests from the form); unset = /leads is 404
# Shown on /privacy and /terms (built in; set these before running ads)
MARKETING_LEGAL_NAME=                    # registered business / proprietor name (defaults to product name)
MARKETING_CONTACT_EMAIL=
MARKETING_ADDRESS=
MARKETING_JURISDICTION=                  # city for the governing-law clause, e.g. Hyderabad, Telangana
MARKETING_LEGAL_UPDATED=                 # e.g. 4 October 2026
MARKETING_PRIVACY_URL=                   # optional: link to externally hosted policies instead
MARKETING_TERMS_URL=

# ── Shared trials app (ONLY on the "trials" Vercel project) ─────────────────
# Many 7-day trials in one deployment + one Postgres database, one schema each.
# Each trial is served at <slug>.<TENANT_BASE_DOMAIN>. Manage with `flask trial ...`.
TENANT_MODE=
TENANT_BASE_DOMAIN=quote-room.co.in
