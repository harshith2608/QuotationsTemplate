# Copy to .env for local development. In production, set these in your host's
# dashboard (Render / Vercel / Heroku). Never commit a real .env file.

# ── Required in production ────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Each deployment gets its OWN Postgres database (Neon / Supabase / Render Postgres).
# Leave unset locally to use a SQLite file (app.db). The app refuses to start in
# production without it.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# "production" when deployed; "development" (default) locally
FLASK_ENV=development

# ── First admin user (used once by `flask bootstrap`) ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Branding ──────────────────────────────────────────────────────────────────
# Company details — defaults for PDFs, emails, WhatsApp and the UI.
# An admin can override any of these later from Admin → Payment Settings.
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_GSTIN=

# Shown in the footer and as the PDF subtitle when no contact details are set
COMPANY_TAGLINE=Interior Design & Furnishing Solutions

# Signature block on PDFs (name defaults to COMPANY_NAME)
SIGNATORY_NAME=
SIGNATORY_TITLE=Proprietor

# Colours as #rrggbb (invalid values fall back to the defaults shown)
BRAND_PRIMARY=#1a237e
BRAND_SECONDARY=#283593
BRAND_ACCENT=#f57f17

# Optional logo: a PNG or JPG placed under static/, e.g. static/brand/logo.png
# Used in the navbar, login page and PDF header. (SVG works on the web but not in PDFs.)
LOGO_FILE=

# ── Demo data (only used by `flask seed-demo`) ────────────────────────────────
DEMO_PASSWORD=demo1234

# ── Payments & email ──────────────────────────────────────────────────────────
# Razorpay keys, UPI / bank details and SMTP settings are entered by an admin
# in Admin → Payment Settings and stored in the database — no env vars needed.
