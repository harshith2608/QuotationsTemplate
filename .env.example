# Copy to .env for local development. In production, set these in your host's
# dashboard (Render / Vercel / Heroku). Never commit a real .env file.

# ── Required in production ────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Each deployment gets its OWN Postgres database (Neon / Supabase / Render Postgres).
# Leave unset locally to use a SQLite file (app.db). The app refuses to start in
# production without it.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# "production" when deployed; "development" (default) locally
FLASK_ENV=development

# ── First admin user (used once by `flask bootstrap`) ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Branding defaults ─────────────────────────────────────────────────────────
# Starting values for a new deployment. The client's admin can change ALL of these
# later from Admin → Settings (Company / Appearance); a saved value there wins,
# and clearing it falls back to what's set here.
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_GSTIN=
COMPANY_TAGLINE=Interior Design & Furnishing Solutions
SIGNATORY_NAME=
SIGNATORY_TITLE=Proprietor

# Theme — colours as #rrggbb (invalid values fall back to the defaults shown)
BRAND_PRIMARY=#1a237e
BRAND_SECONDARY=#283593
BRAND_ACCENT=#f57f17
BRAND_BACKGROUND=#f5f6fa
BRAND_HEADER=gradient        # gradient | solid | light
BRAND_CORNERS=rounded        # sharp | rounded | soft
BRAND_BUTTONS=standard       # standard | pill
BRAND_FONT=system            # system | inter | poppins | montserrat | lato | nunito | dm-sans | lora

# Optional logo baked into the deployment: a PNG/JPG under static/, e.g. brand/logo.png.
# A logo uploaded in Admin → Settings → Appearance takes precedence.
LOGO_FILE=

# ── Demo data (only used by `flask seed-demo`) ────────────────────────────────
DEMO_PASSWORD=demo1234

# ── Payments & email ──────────────────────────────────────────────────────────
# Razorpay keys and UPI / bank details (Admin → Payment Settings) and SMTP
# (Admin → Settings → Email) are entered by an admin and stored in the database.

# ── Marketing page (ONLY on your own demo/marketing deployment) ──────────────
# Serves the product's public landing page at /landingpage. Leave unset on client
# deployments so their apps return 404 for it.
MARKETING_SITE=
MARKETING_PRODUCT_NAME=QuoteRoom
MARKETING_WHATSAPP=919999999999          # country code + number, digits only
META_PIXEL_ID=                           # optional, Meta Pixel ID (digits)
GOOGLE_ADS_ID=                           # optional, e.g. AW-123456789
GOOGLE_ADS_CONVERSION=                   # optional, e.g. AW-123456789/AbCdEf (fired on WhatsApp clicks)
MARKETING_PRIVACY_URL=                   # optional footer links
MARKETING_TERMS_URL=
